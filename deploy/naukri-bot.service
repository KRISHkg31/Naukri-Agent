[Unit]
Description=Naukri profile bot (Telegram, multi-user, runs the daily schedule itself)
Wants=network-online.target
After=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python main.py bot
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
UMask=0077

[Install]
WantedBy=multi-user.target
