# Copy this file to .env and fill in your own values. .env is never committed.

# Naukri login (used only when the saved session has expired)
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# Telegram alerts + OTP replies (see README: "Telegram bot")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Encrypts users' saved Naukri sessions (bot). Generate: python main.py gen-key
SESSION_KEY=
