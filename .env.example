# Copy this file to .env and fill in your own values. .env is never committed.

# Naukri login (used only when the saved session has expired)
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# Telegram alerts + OTP replies (see README: "Telegram bot")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Encrypts users' saved Naukri sessions (bot). Generate: python main.py gen-key
SESSION_KEY=

# WhatsApp Cloud API (optional - bot runs Telegram-only if these are empty)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=naukri_update
WHATSAPP_TEMPLATE_LANG=en
# Public HTTPS address of the VM (Caddy), e.g. https://krish-naukri.duckdns.org
PUBLIC_BASE_URL=
